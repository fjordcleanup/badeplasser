{
  "name": "@fjordcleanup/badeplasser",
  "version": "0.0.0-development",
  "description": "Web application to view and report trash to Fjord CleanUP",
  "homepage": "https://badeplasser.fjordcleanup.org",
  "bugs": {
    "url": "https://github.com/fjordcleanup/badeplasser/issues"
  },
  "license": "MIT",
  "author": "Markus Tacker <m@coderbyheart.com> | https://coderbyheart.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fjordcleanup/badeplasser.git"
  },
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "node --max_old_space_size=8192 ./node_modules/vite/bin/vite.js build --emptyOutDir",
    "prepare": "husky && case \"$npm_command\" in install|ci) check-node-version --package ;; esac",
    "test": "node --no-warnings --experimental-transform-types --test \"!(node_modules)/**/*.spec.ts\"",
    "test:watch": "node --no-warnings --experimental-transform-types --test --watch \"!(node_modules)/**/*.spec.ts\"",
    "badeplasser:generate": "node --no-warnings --experimental-transform-types scripts/generate-badeplasser.ts",
    "badeplasser:update": "node --no-warnings --experimental-transform-types scripts/update-water-quality.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52",
    "bootstrap": "5.3.9",
    "classnames": "2.5.1",
    "date-fns": "4.4.0",
    "leaflet": "1.9.4",
    "lucide-preact": "1.73.0",
    "preact": "11.2.0",
    "preact-router": "4.1.2",
    "proj4": "2.23.0",
    "ulidx": "2.4.1"
  },
  "devDependencies": {
    "@babel/plugin-syntax-import-assertions": "7.29.7",
    "@bifravst/cloudformation-helpers": "10.0.3",
    "@coderbyheart/oxlint-config": "1.0.1",
    "@commitlint/config-conventional": "21.2.4",
    "@preact/preset-vite": "2.10.6",
    "@types/leaflet": "1.9.22",
    "@types/node": "26.6.6",
    "check-node-version": "4.2.1",
    "commitlint": "21.2.4",
    "glob": "14.0.6",
    "handlebars": "4.7.10",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.{md,json,yaml,yml,html,css}": [
      "oxfmt --write"
    ]
  },
  "release": {
    "branches": [
      "saga"
    ],
    "remoteTags": true,
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      [
        "@semantic-release/github",
        {
          "successCommentCondition": false
        }
      ]
    ]
  },
  "engines": {
    "node": ">=24.18.1 <27",
    "npm": ">=12.0.2 <13"
  }
}
